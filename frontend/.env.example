# ============================================
# LICITABOT BOLIVIA - VERCEL DEPLOYMENT ENV
# ============================================
# INSTRUCCIONES: Copia todas estas variables y pégalas 
# en la pestaña "Environment Variables" de Vercel.

# 1. API del Servidor (Backend Python)
# Cuando tu compañero despliegue el backend en Render/Railway, cambia este URL.
# MIENTRAS TANTO, PUEDES DEJAR ESTO VACÍO O CON UN PLACEHOLDER PARA VERCEL.
NEXT_PUBLIC_API_URL=https://tu-backend-python.onrender.com

# 2. Zavu API (Notificaciones SMS/Telegram)
# Cópialas exacto como las tienes en tu .env.local
ZAVU_API_KEY=tu_zavu_api_key_aqui
ZAVU_API_URL=https://api.zavu.io/v1

# 3. Inteligencia Artificial (OpenRouter)
NEXT_PUBLIC_LLM_PROVIDER=openai
OPENROUTER_API_KEY=tu_llave_de_openrouter_aqui

# 4. Entorno de Producción
NODE_ENV=production

# 5. Autenticación (Google OAuth)
# IMPORTANTE: En Vercel, el NEXTAUTH_URL debe ser el dominio oficial 
# que te dé Vercel (ej: https://licitabot.vercel.app)
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_secret
NEXTAUTH_SECRET=genera_un_texto_largo_y_aleatorio_aqui
NEXTAUTH_URL=https://tu-dominio-en-vercel.vercel.app

# 6. Correos
RESEND_API_KEY=tu_llave_de_resend
